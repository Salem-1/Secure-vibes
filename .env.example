# Copy this file to .env and fill in what you need. Every value is optional.

# Gemma 4 executive brief (https://openrouter.ai/keys). Without it, the brief is skipped.
OPENROUTER_API_KEY=
# Free tier: google/gemma-4-31b-it:free
OPENROUTER_MODEL=google/gemma-4-31b-it

# Optional: Gemini Flash voiceover for the demo video (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: the domain that plays back the built-in sample report instead of scanning
DEMO_DOMAIN=MyAwesomeVibeCodedWebsite.com
